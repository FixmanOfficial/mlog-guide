---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import InstructionsIndex from '../../../../reference/InstructionsIndex.astro'
import {byCategory} from '../../../../reference/data.js'

// Оглавление справа: у custom-страницы его надо собрать самому
const headings = byCategory('en').map(group => ({depth: 2, slug: group.category, text: group.title}))
---
<StarlightPage frontmatter={{
    title: 'Instructions',
    description: 'Every mlog instruction: in-game names, categories, parameters'
}} headings={headings}>
    <InstructionsIndex locale="en" />
</StarlightPage>
