---
/**
 * Список курса: группы, а в каждой уроки с кружком сложности.
 *
 * Группа — это инструкция. Пришедший за юнитами открывает `ucontrol` и читает её, а не
 * проходит курс по порядку; поэтому группы независимы, а что нужно знать заранее, каждая
 * пишет у себя вверху.
 */

import {courseGroups} from './data.js'
import {LEVELS, LEVEL_ORDER} from './levels.js'
import LessonList from './LessonList.astro'
import './course.css'

const {locale = 'ru'} = Astro.props

const groups = await courseGroups(locale)

const TEXT = {
    ru: {
        intro: 'Курс разбирает язык по инструкциям: группа — инструкция, урок — одна её грань. '
            + 'Группы независимы: за юнитами можно идти сразу в них, а что нужно знать заранее, '
            + 'написано в начале каждой.',
        legend: 'Сложность'
    },
    en: {
        intro: 'The course goes instruction by instruction: a group is an instruction, a lesson '
            + 'is one facet of it. Groups are independent — go straight to the unit ones; each '
            + 'says up front what you need to know first.',
        legend: 'Difficulty'
    }
}

const text = TEXT[locale] ?? TEXT.en
---

<p class="ref-lead">{text.intro}</p>

<div class="legend">
    {LEVEL_ORDER.map(name => (
        <>
            <div class="legend__level">
                <span class="level__dot" style={`--level: ${LEVELS[name].color}`}></span>
                {LEVELS[name].title[locale]}
            </div>
            <div class="legend__hint">{LEVELS[name].hint[locale]}</div>
        </>
    ))}
</div>

{groups.map(group => (
    <section class="group">
        <h2 id={group.name}>
            <a class="group__name" href={group.href}>{group.title}</a>
        </h2>
        {group.lead === null ? null : <p class="group__lead">{group.lead}</p>}
        <LessonList locale={locale} group={group.name} />
    </section>
))}
