---
/**
 * Список курса: части, в них категории игры, в категориях группы, в группах уроки
 * с кружком сложности.
 *
 * Часть отвечает на «чем я занят»: язык, логический процессор, мировой, приёмы поверх
 * инструкций. Категория — та же, что в меню «Добавить»: читатель уже знает, что `sensor`
 * живёт в «Управлении блоками», и искать его будет там же. Раскладка описана один раз,
 * в `parts.js`.
 *
 * Группы независимы: пришедший за юнитами открывает нужную и читает её, а не проходит
 * курс по порядку; что нужно знать заранее, каждая пишет у себя вверху.
 */

import ru from '@mlog/core/data/i18n/ru.json'
import en from '@mlog/core/data/i18n/en.json'
import {CATEGORY_COLORS} from '@mlog/editor/src/theme.js'

import {courseParts} from './data.js'
import {LEVELS, LEVEL_ORDER} from './levels.js'
import LessonList from './LessonList.astro'
import './course.css'

const {locale = 'ru'} = Astro.props

/** Названия категорий берём из переводов игры: в меню «Добавить» они ровно такие. */
const bundle = locale === 'ru' ? ru : en
const categoryName = (key) => bundle.logic?.categories?.[key] ?? key

const parts = await courseParts(locale, categoryName)

const TEXT = {
    ru: {
        intro: 'Курс разложен по тому, чем вы заняты: язык, логический процессор, мировой '
            + 'и приёмы поверх инструкций. Внутри — категории и группы из самой игры: группа — '
            + 'инструкция, урок — одна её грань. Группы независимы: за юнитами можно идти '
            + 'сразу в них, а что нужно знать заранее, написано в начале каждой.',
        legend: 'Сложность'
    },
    en: {
        intro: 'The course is split by what you are doing: the language, the logic processor, '
            + 'the world processor, and the techniques on top. Inside are the same categories '
            + 'and groups the game itself uses: a group is an instruction, a lesson is one '
            + 'facet of it. Groups are independent — go straight to the unit ones; each says '
            + 'up front what you need to know first.',
        legend: 'Difficulty'
    }
}

const text = TEXT[locale] ?? TEXT.en

/** Цвет категории — тот же, что у шапки строки инструкции в блоке. */
const color = (key) => key === null ? undefined : `--category: ${CATEGORY_COLORS[key]}`
---

<p class="ref-lead">{text.intro}</p>

<div class="legend">
    {LEVEL_ORDER.map(name => (
        <>
            <div class="legend__level">
                <span class="level__dot" style={`--level: ${LEVELS[name].color}`}></span>
                {LEVELS[name].title[locale]}
            </div>
            <div class="legend__hint">{LEVELS[name].hint[locale]}</div>
        </>
    ))}
</div>

{parts.map(part => (
    <section class="part">
        <h2 id={part.name}>
            {part.href === null
                ? part.title
                : <a class="group__name" href={part.href}>{part.title}</a>}
        </h2>

        {part.sections.map(section => (
            <div class="part__category" style={color(section.category)}>
                {section.title === null ? null : (
                    <h3 id={section.name} class="part__name">{section.title}</h3>
                )}

                {section.groups.map(group => (
                    <>
                        {group.title === null ? null : (
                            <h4 id={group.name}>
                                <a class="group__name" href={group.href}>{group.title}</a>
                            </h4>
                        )}
                        {group.lead === null ? null : <p class="group__lead">{group.lead}</p>}
                        <LessonList locale={locale} group={group.name} />
                    </>
                ))}
            </div>
        ))}
    </section>
))}
