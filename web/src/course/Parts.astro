---
/**
 * Разбор строки инструкции: слева часть, справа что это.
 *
 * Раньше это были абзацы с жирным началом, и глаз не связывал их с блоком в примере выше.
 * Двумя колонками связь видна сразу: слева ровно то, что написано в поле, справа объяснение.
 */

import './course.css'
import {localeOf} from './locale.js'

const TITLE = {ru: 'Что здесь на что', en: 'What is what here'}

const {title = TITLE[localeOf(Astro.url)]} = Astro.props
---
<div class="parts">
    <p class="parts__title">{title}</p>
    <dl class="parts__list"><slot /></dl>
</div>
