---
/**
 * Карточка урока: подпись роли и текст под ней.
 *
 * Ролей всего три — скрытая ошибка, «запомнить» и задание, — и в каждом уроке они на своих
 * местах. Смысл в узнавании: читатель видит форму раньше, чем читает слова, и знает, что
 * красная полоса это место, где программа сломается молча, а жёлтая — то, что нужно сделать
 * руками. Заворачивать в карточку обычный абзац нельзя: если выделено всё, не выделено ничего.
 *
 * «Скрытая ошибка», а не «грабли»: в этих карточках всегда одно и то же — программа
 * продолжает работать, ошибки нет, а делается не то. Название должно говорить именно это.
 *
 * Цвета — из палитры игры, те же три, что у сложности урока.
 */

import pal from '@mlog/core/data/pal.json' with {type: 'json'}
import './course.css'

const KINDS = {
    error: {color: pal.colors.remove, title: {ru: 'Скрытая ошибка', en: 'Silent failure'}},
    recap: {color: pal.colors.heal, title: {ru: 'Запомнить', en: 'Remember'}},
    task: {color: pal.colors.accent, title: {ru: 'Задание', en: 'Task'}}
}

const {kind = 'error', title, locale = 'ru'} = Astro.props

const role = KINDS[kind] ?? KINDS.error
---
<aside class={`card card--${kind}`} style={`--card: ${role.color}`}>
    <p class="card__title">{title ?? role.title[locale] ?? role.title.en}</p>
    <div class="card__body"><slot /></div>
</aside>
